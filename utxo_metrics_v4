def sha256_file(path: Path, chunk: int = 8 << 20) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        while True:
            b = f.read(chunk)
            if not b:
                break
            h.update(b)
    return h.hexdigest()


def canonical_sha(obj: Any) -> str:
    raw = json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(raw).hexdigest()


def regular_single(path: Path) -> Path:
    p = path.resolve(strict=True)
    if path.is_symlink() or not p.is_file():
        raise RuntimeError(f"required regular file invalid: {path}")
    st = p.stat()
    if st.st_nlink != 1:
        raise RuntimeError(f"hardlinked authoritative file refused: {p} nlink={st.st_nlink}")
    return p


def file_token(path: Path) -> Dict[str, int]:
    p = regular_single(path)
    st = p.stat()
    return {"dev": int(st.st_dev), "ino": int(st.st_ino), "size": int(st.st_size), "mtime_ns": int(st.st_mtime_ns), "ctime_ns": int(st.st_ctime_ns)}


def same_token(a: Dict[str, int], b: Dict[str, int]) -> bool:
    return all(a.get(k) == b.get(k) for k in ("dev", "ino", "size", "mtime_ns", "ctime_ns"))


def fsync_dir(path: Path) -> None:
    fd = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def fsync_file(path: Path) -> None:
    fd = os.open(str(path), os.O_RDONLY | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_json(path: Path, obj: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}.{time.time_ns()}")
    raw = json.dumps(obj, ensure_ascii=False, sort_keys=True, indent=2).encode("utf-8") + b"\n"
    fd = os.open(str(tmp), os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_CLOEXEC, 0o640)
    try:
        off = 0
        while off < len(raw):
            n = os.write(fd, raw[off:])
            if n <= 0:
                raise RuntimeError(f"short atomic JSON write: {tmp}")
            off += n
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    fsync_dir(path.parent)


def write_csv_durable(path: Path, series: pd.Series) -> Dict[str, Any]:
    path.parent.mkdir(parents=True, exist_ok=True)
    pd.DataFrame({"timestamp": series.index.astype(str), "value": series.to_numpy()}).to_csv(path, index=False)
    fsync_file(path)
    return {"sha256": sha256_file(path), "rows": int(len(series)), "size": int(path.stat().st_size)}


def read_json(path: Path) -> Dict[str, Any]:
    obj = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(obj, dict):
        raise RuntimeError(f"JSON object expected: {path}")
    return obj


def read_sidecar(path: Path) -> str:
    p = regular_single(path)
    toks = p.read_text(encoding="ascii", errors="strict").strip().split()
    if not toks or len(toks[0]) != 64:
        raise RuntimeError(f"invalid SHA256 sidecar: {p}")
    return toks[0].lower()


class FreezeLease:
    """Same shared lock order as V51 auditor: supervisor -> R11 driver -> state."""
    def __init__(self, state: Path):
        self.state = state.resolve(strict=True)
        self.fds: List[Tuple[str, Path, int]] = []

    def __enter__(self):
        paths = [
            (self.state.parent / ".v50-r12-supervisor.lock", "R12 supervisor"),
            (self.state.parent / ".v50-driver.lock", "R11 driver"),
            (self.state / "LOCK", "V50 state"),
        ]
        try:
            for path, label in paths:
                p = regular_single(path)
                fd = os.open(str(p), os.O_RDONLY | os.O_CLOEXEC)
                try:
                    fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
                except OSError as exc:
                    os.close(fd)
                    raise RuntimeError(f"{label} lock busy; writer/mutator active: {p}") from exc
                self.fds.append((label, p, fd))
        except BaseException:
            self.__exit__(None, None, None)
            raise
        return self

    def summary(self) -> Dict[str, Any]:
        return {label: {"path": str(path), "shared_lock_held": True} for label, path, _ in self.fds}

    def __exit__(self, *_):
        while self.fds:
            _, _, fd = self.fds.pop()
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            finally:
                os.close(fd)


class OutputLease:
    def __init__(self, output_dir: Path):
        self.path = output_dir / ".utxo_metrics_v4.lock"
        self.fd = -1

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.fd = os.open(str(self.path), os.O_CREAT | os.O_RDWR | os.O_CLOEXEC, 0o640)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as exc:
            os.close(self.fd); self.fd = -1
            raise RuntimeError(f"metrics output already in use: {self.path}") from exc
        os.ftruncate(self.fd, 0)
        os.write(self.fd, (json.dumps({"pid": os.getpid(), "version": VERSION, "created_utc": utc_now()}) + "\n").encode())
        os.fsync(self.fd)
        return self

    def __exit__(self, *_):
        if self.fd >= 0:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            finally:
                os.close(self.fd); self.fd = -1
        try:
            self.path.unlink(missing_ok=True)
        except Exception:
            pass


def utc_now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def parse_state(state: Path) -> Dict[str, Any]:
    state = state.resolve(strict=True)
    if (state / "dirty.bin").exists():
        raise RuntimeError("dirty.bin present: metrics refuse recovery/mutation")
    temp_artifacts = sorted(str(x) for x in state.glob("*.tmp.*") if x.exists())
    if temp_artifacts:
        raise RuntimeError(f"stale/unknown state temp artifacts present: {temp_artifacts[:20]}")
    for n in ("state.meta", "checkpoint.bin", "tx_records.bin", "outputs.bin", "closes.bin", "scripts.bin", "LOCK"):
        regular_single(state / n)
    mraw = (state / "state.meta").read_bytes()
    craw = (state / "checkpoint.bin").read_bytes()
    if len(mraw) != META.size or len(craw) != CHECKPOINT.size:
        raise RuntimeError("state.meta/checkpoint physical size mismatch")
    mv = META.unpack(mraw); cv = CHECKPOINT.unpack(craw)
    if mv[0] != b"V50META1" or mv[1] != V50_STATE_VERSION or mv[2] != 0x01020304:
        raise RuntimeError("V50 state.meta magic/version/endian mismatch")
    if cv[0] != b"V50CP01\x00" or cv[1] != V50_STATE_VERSION:
        raise RuntimeError("V50 checkpoint magic/version mismatch")
    if hashlib.sha256(mraw[:-32]).digest() != mv[-1]:
        raise RuntimeError("state.meta checksum mismatch")
    if hashlib.sha256(craw[:-32]).digest() != cv[-1]:
        raise RuntimeError("checkpoint checksum mismatch")
    txcap, outcap, closecap, hashcap = map(int, mv[3:7])
    txsz, outsz, closesz, hashsz = map(int, mv[7:11])
    source_sha, core_sha, driver_sha = (x.hex() for x in mv[11:14])
    height = int(cv[2]); block_hash = cv[3].hex()
    txc, outc, closec, script_bytes, live_count, live_value = map(int, cv[4:10])
    cp_source = cv[12].hex()
    if source_sha != cp_source:
        raise RuntimeError("state.meta/checkpoint source SHA mismatch")
    if driver_sha != EXPECTED_R11_SHA256:
        raise RuntimeError(f"state is not bound to certified R11 driver: {driver_sha}")
    if (txsz, outsz, closesz, hashsz) != (TX_RECORD_SIZE, OUT_RECORD_SIZE, CLOSE_RECORD_SIZE, HASH_SLOT_SIZE):
        raise RuntimeError("V50 record-size contract mismatch")
    if txc > txcap or outc > outcap or closec > closecap:
        raise RuntimeError("checkpoint counters exceed capacities")
    expected_sizes = {
        "tx_records.bin": txcap * TX_RECORD_SIZE,
        "outputs.bin": outcap * OUT_RECORD_SIZE,
        "closes.bin": closecap * CLOSE_RECORD_SIZE,
        "scripts.bin": script_bytes,
    }
    for n, exp in expected_sizes.items():
        got = (state / n).stat().st_size
        if got != exp:
            raise RuntimeError(f"physical state size mismatch {n}: {got} != {exp}")
    # out_count contains ALL transaction outputs.  Only OUT_FLAG_ELIGIBLE outputs
    # participate in the live UTXO set, while every CloseRecord refers to an eligible
    # output.  Therefore out_count-close_count is NOT the live_count contract.
    if live_count < 0 or live_count > outc - closec:
        raise RuntimeError(f"checkpoint live_count impossible live={live_count} out={outc} close={closec}")
    if live_value < 0:
        raise RuntimeError(f"checkpoint live_value_sats negative: {live_value}")
    return {
        "path": str(state), "height": height, "block_hash": block_hash,
        "tx_count": txc, "out_count": outc, "close_count": closec,
        "script_bytes": script_bytes, "live_count": live_count, "live_value_sats": live_value,
        "source_sha256": source_sha, "core_sha256": core_sha, "driver_sha256": driver_sha,
        "meta_sha256": hashlib.sha256(mraw).hexdigest(), "checkpoint_sha256": hashlib.sha256(craw).hexdigest(),
        "capacities": {"tx": txcap, "out": outcap, "close": closecap, "hash": hashcap},
    }


def state_snapshot_tokens(state: Path) -> Dict[str, Dict[str, int]]:
    state = state.resolve(strict=True)
    return {str(state / n): file_token(state / n) for n in (
        "state.meta", "checkpoint.bin", "tx_records.bin", "outputs.bin", "closes.bin", "scripts.bin"
    )}


def validate_state_tokens(tokens: Dict[str, Dict[str, int]]) -> None:
    changed = [p for p, tok in tokens.items() if not same_token(tok, file_token(Path(p)))]
    if changed:
        raise RuntimeError(f"V50 state payload changed while metrics were running: {changed[:10]}")


def _ledger_rows(path: Path, schema: str) -> Tuple[List[Dict[str, Any]], str]:
    p = regular_single(path)
    raw = p.read_bytes()
    if raw and not raw.endswith(b"\n"):
        raise RuntimeError(f"torn provenance JSONL tail: {p}")
    rows: List[Dict[str, Any]] = []
    prev = "0" * 64
    for i, line in enumerate(raw.decode("utf-8").splitlines(), 1):
        if not line.strip():
            raise RuntimeError(f"blank provenance JSONL record path={p} line={i}")
        obj = json.loads(line)
        if not isinstance(obj, dict):
            raise RuntimeError(f"provenance record is not object path={p} line={i}")
        if obj.get("schema") != schema or int(obj.get("record_no") or 0) != i or str(obj.get("previous_record_sha256") or "") != prev:
            raise RuntimeError(f"provenance chain/header invalid path={p} record={i}")
        exp = canonical_sha({k: v for k, v in obj.items() if k != "record_sha256"})
        if str(obj.get("record_sha256") or "") != exp:
            raise RuntimeError(f"provenance record hash invalid path={p} record={i}")
        prev = exp
        rows.append(obj)
    return rows, hashlib.sha256(raw).hexdigest()


def _sha256_field(value: Any, label: str) -> str:
    token = str(value or "").lower()
    if len(token) != 64 or any(c not in "0123456789abcdef" for c in token):
        raise RuntimeError(f"invalid SHA256 field {label}")
    return token


def _validate_source_lineage(
    apply: Sequence[Dict[str, Any]],
    recovery: Sequence[Dict[str, Any]],
    lineage: Sequence[Dict[str, Any]],
    state_source_sha256: str,
    state_height: int,
) -> Dict[str, Any]:
    """Validate historical APPLY sources through immutable R12 source upgrades.

    A source upgrade does not rewrite historical APPLY records.  Records through
    the upgrade's committed_height remain bound to the old source; records after
    that height must use the new source.  The lineage terminal, not every old
    APPLY row, is what must equal state.meta/checkpoint's current source.
    """
    if not apply or not recovery:
        raise RuntimeError("R12 provenance requires non-empty apply and recovery ledgers")

    epoch = recovery[0]
    epoch_source = _sha256_field(epoch.get("source_sha256"), "provenance_epoch.source_sha256")
    current_source = _sha256_field(state_source_sha256, "state.source_sha256")
    state_height = int(state_height)

    expected_source = epoch_source
    previous_height = -1
    transitions: List[Dict[str, Any]] = []
    apply_tail_heights = {int(r.get("h2", -1)) for r in apply}

    for r in lineage:
        record_no = int(r.get("record_no", -1))
        if r.get("action") != "SOURCE_EXTENSION_COMMIT":
            raise RuntimeError(f"unsupported source-lineage action record={record_no} action={r.get('action')}")
        old_source = _sha256_field(r.get("old_source_sha256"), f"source_lineage[{record_no}].old_source_sha256")
        new_source = _sha256_field(r.get("new_source_sha256"), f"source_lineage[{record_no}].new_source_sha256")
        if old_source == new_source:
            raise RuntimeError(f"source-lineage self-transition record={record_no}")
        if old_source != expected_source:
            raise RuntimeError(
                f"source-lineage is not linear record={record_no} "
                f"expected_old={expected_source} actual_old={old_source}"
            )
        try:
            committed_height = int(r["committed_height"])
        except Exception as exc:
            raise RuntimeError(f"source-lineage committed_height invalid record={record_no}") from exc
        if committed_height < 0 or committed_height > state_height or committed_height < previous_height:
            raise RuntimeError(
                f"source-lineage committed_height invalid record={record_no} "
                f"previous={previous_height} current={committed_height} state={state_height}"
            )
        if committed_height not in apply_tail_heights:
            raise RuntimeError(
                f"source-lineage committed_height is not an APPLY boundary "
                f"record={record_no} height={committed_height}"
            )
        if str(r.get("r11_engine_sha256") or "").lower() != EXPECTED_R11_SHA256:
            raise RuntimeError(f"source-lineage R11 pin mismatch record={record_no}")
        if str(r.get("supervisor_sha256") or "").lower() != EXPECTED_R12_SHA256:
            raise RuntimeError(f"source-lineage supervisor pin mismatch record={record_no}")
        for field in (
            "old_source_fingerprint_sha256", "new_source_fingerprint_sha256",
            "pre_fingerprint_sha256", "post_fingerprint_sha256", "committed_block_hash",
        ):
            _sha256_field(r.get(field), f"source_lineage[{record_no}].{field}")
        if str(r.get("pre_fingerprint_sha256") or "").lower() != str(r.get("post_fingerprint_sha256") or "").lower():
            raise RuntimeError(f"source-lineage semantic fingerprint changed record={record_no}")
        if r.get("historical_execution_provenance_changed") is not False:
            raise RuntimeError(f"source-lineage historical provenance changed record={record_no}")
        prefix = r.get("prefix_equivalence")
        if not isinstance(prefix, dict):
            raise RuntimeError(f"source-lineage prefix proof missing record={record_no}")
        if (
            prefix.get("status") != "GREEN"
            or int(prefix.get("through_height", -1)) != committed_height
            or prefix.get("window_fingerprint_compatible") is not True
            or prefix.get("window_fingerprint_schema") != WINDOW_FINGERPRINT_SCHEMA
            or int(prefix.get("windows_checked", 0)) <= 0
        ):
            raise RuntimeError(f"source-lineage prefix proof invalid record={record_no}")

        transitions.append({
            "record_no": record_no,
            "record_sha256": _sha256_field(r.get("record_sha256"), f"source_lineage[{record_no}].record_sha256"),
            "old_source_sha256": old_source,
            "new_source_sha256": new_source,
            "committed_height": committed_height,
        })
        expected_source = new_source
        previous_height = committed_height

    if expected_source != current_source:
        raise RuntimeError(
            f"source-lineage terminal mismatch expected={expected_source} current_state_source={current_source}"
        )

    recovery_upgrades = [r for r in recovery[1:] if r.get("action") == "SOURCE_UPGRADE_COMMITTED"]
    if len(recovery_upgrades) != len(transitions):
        raise RuntimeError(
            f"source-lineage/recovery upgrade count mismatch "
            f"lineage={len(transitions)} recovery={len(recovery_upgrades)}"
        )
    for transition, recovered in zip(transitions, recovery_upgrades):
        record_no = int(recovered.get("record_no", -1))
        if (
            str(recovered.get("old_source_sha256") or "").lower() != transition["old_source_sha256"]
            or str(recovered.get("new_source_sha256") or "").lower() != transition["new_source_sha256"]
            or int(recovered.get("committed_height", -1)) != transition["committed_height"]
            or str(recovered.get("lineage_record_sha256") or "").lower() != transition["record_sha256"]
            or recovered.get("semantic_fingerprint_unchanged") is not True
        ):
            raise RuntimeError(f"source upgrade recovery binding mismatch record={record_no}")

    transition_index = 0
    active_source = epoch_source
    for r in apply:
        record_no = int(r.get("record_no", -1))
        h1, h2 = int(r.get("h1", -1)), int(r.get("h2", -1))
        while transition_index < len(transitions) and transitions[transition_index]["committed_height"] < h1:
            active_source = transitions[transition_index]["new_source_sha256"]
            transition_index += 1
        if (
            transition_index < len(transitions)
            and h1 <= transitions[transition_index]["committed_height"] < h2
        ):
            raise RuntimeError(
                f"APPLY record straddles source transition record={record_no} "
                f"transition_height={transitions[transition_index]['committed_height']} range={h1}..{h2}"
            )
        actual_source = _sha256_field(r.get("source_sha256"), f"apply[{record_no}].source_sha256")
        if actual_source != active_source:
            raise RuntimeError(
                f"R12 apply ledger source mismatch record={record_no} "
                f"expected={active_source} actual={actual_source}"
            )

    apply_terminal_source = _sha256_field(apply[-1].get("source_sha256"), "apply.tail.source_sha256")
    return {
        "status": "GREEN",
        "epoch_source_sha256": epoch_source,
        "terminal_source_sha256": expected_source,
        "apply_terminal_source_sha256": apply_terminal_source,
        "records": len(transitions),
        "transitions": transitions,
    }


def validate_r12_provenance(state_path: Path, sc: Dict[str, Any]) -> Dict[str, Any]:
    root = state_path.resolve(strict=True) / "provenance_r12"
    if root.is_symlink() or not root.is_dir():
        raise RuntimeError(f"R12 provenance directory missing/invalid: {root}")
    apply_path = root / "apply_ledger_v2.jsonl"
    recovery_path = root / "recovery_ledger_v2.jsonl"
    lineage_path = root / "source_lineage_v1.jsonl"
    apply, apply_sha = _ledger_rows(apply_path, APPLY_LEDGER_SCHEMA)
    recovery, recovery_sha = _ledger_rows(recovery_path, RECOVERY_LEDGER_SCHEMA)
    if not apply:
        raise RuntimeError("R12 apply provenance is empty")
    if not recovery:
        raise RuntimeError("R12 recovery/provenance epoch ledger is empty")
    expected_h1 = 0
    for r in apply:
        h1, h2 = int(r.get("h1", -1)), int(r.get("h2", -1))
        if h1 != expected_h1 or h2 < h1:
            raise RuntimeError(f"R12 apply ledger range discontinuity record={r.get('record_no')} expected_h1={expected_h1} got={h1}..{h2}")
        if str(r.get("r11_engine_sha256") or "").lower() != EXPECTED_R11_SHA256:
            raise RuntimeError(f"R12 apply ledger R11 pin mismatch record={r.get('record_no')}")
        if str(r.get("supervisor_sha256") or "").lower() != EXPECTED_R12_SHA256:
            raise RuntimeError(f"R12 apply ledger supervisor pin mismatch record={r.get('record_no')}")
        expected_h1 = h2 + 1
    if expected_h1 - 1 != int(sc["height"]):
        raise RuntimeError(f"R12 apply ledger tail={expected_h1-1} != checkpoint height={sc['height']}")
    tail = apply[-1]
    final_fields = {
        "state_block_hash": sc["block_hash"], "state_tx_count": sc["tx_count"],
        "state_out_count": sc["out_count"], "state_close_count": sc["close_count"],
        "state_script_bytes": sc["script_bytes"], "state_live_count": sc["live_count"],
        "state_live_value_sats": sc["live_value_sats"],
    }
    for k, expected in final_fields.items():
        if k in tail and str(tail.get(k)) != str(expected):
            raise RuntimeError(f"R12 apply ledger terminal state mismatch field={k} ledger={tail.get(k)} checkpoint={expected}")
    for r in recovery:
        if "r11_engine_sha256" in r and str(r.get("r11_engine_sha256") or "").lower() != EXPECTED_R11_SHA256:
            raise RuntimeError(f"R12 recovery ledger R11 pin mismatch record={r.get('record_no')}")
        if "supervisor_sha256" in r and str(r.get("supervisor_sha256") or "").lower() != EXPECTED_R12_SHA256:
            raise RuntimeError(f"R12 recovery ledger supervisor pin mismatch record={r.get('record_no')}")
    epoch = recovery[0]
    if epoch.get("action") != PROVENANCE_EPOCH_ACTION:
        raise RuntimeError("R12 provenance epoch is not recovery ledger record 1")
    if str(epoch.get("state") or "") != str(state_path.resolve()):
        raise RuntimeError("R12 provenance epoch state path mismatch")
    if str(epoch.get("r11_engine_sha256") or "").lower() != EXPECTED_R11_SHA256:
        raise RuntimeError("R12 provenance epoch R11 pin mismatch")
    if str(epoch.get("supervisor_sha256") or "").lower() != EXPECTED_R12_SHA256:
        raise RuntimeError("R12 provenance epoch supervisor pin mismatch")
    if lineage_path.exists():
        lineage, lineage_sha = _ledger_rows(lineage_path, SOURCE_LINEAGE_SCHEMA)
        lineage_file = str(lineage_path.resolve())
        lineage_presence = "PRESENT" if lineage else "EMPTY"
    else:
        lineage, lineage_sha = [], None
        lineage_file = None
        lineage_presence = "MISSING"
    lineage_status = _validate_source_lineage(
        apply, recovery, lineage, str(sc["source_sha256"]), int(sc["height"])
    )
    lineage_status.update({
        "presence": lineage_presence,
        "path": lineage_file,
        "sha256": lineage_sha,
    })
    return {
        "status": "GREEN",
        "apply": {"path": str(apply_path.resolve()), "sha256": apply_sha, "records": len(apply), "tail_height": expected_h1 - 1, "tail_record_sha256": tail["record_sha256"]},
        "recovery": {"path": str(recovery_path.resolve()), "sha256": recovery_sha, "records": len(recovery), "epoch_origin": epoch.get("origin"), "epoch_record_sha256": epoch["record_sha256"]},
        "source_lineage": lineage_status,
        "stage_source_sha256": lineage_status["apply_terminal_source_sha256"],
    }


def _literal_assignments(source: bytes, label: str) -> Dict[str, Any]:
    try:
        tree = ast.parse(source.decode("utf-8"), filename=label)
    except Exception as exc:
        raise RuntimeError(f"cannot parse {label}: {exc}") from exc
    out: Dict[str, Any] = {}
    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        try:
            value = ast.literal_eval(node.value)
        except Exception:
            continue
        for target in node.targets:
            if isinstance(target, ast.Name):
                out[target.id] = value
    return out


def validate_calculator_contract(state: Dict[str, Any], supervisor_path: Path, driver_path: Path, core_path: Path) -> Dict[str, Any]:
    """Bind metrics to the exact production R12.9 -> embedded R11 -> dense-core lineage."""
    supervisor = regular_single(supervisor_path)
    driver = regular_single(driver_path)
    core = regular_single(core_path)
    supervisor_sha = sha256_file(supervisor)
    driver_sha = sha256_file(driver)
    core_sha = sha256_file(core)
    if supervisor_sha != EXPECTED_R12_SHA256:
        raise RuntimeError(f"production R12.9 supervisor SHA mismatch actual={supervisor_sha} expected={EXPECTED_R12_SHA256}")
    if driver_sha != EXPECTED_R11_SHA256:
        raise RuntimeError(f"production R11 driver SHA mismatch actual={driver_sha} expected={EXPECTED_R11_SHA256}")
    if str(state["driver_sha256"]) != EXPECTED_R11_SHA256:
        raise RuntimeError(f"state driver SHA mismatch actual={state['driver_sha256']} expected={EXPECTED_R11_SHA256}")
    if str(state["core_sha256"]) != core_sha:
        raise RuntimeError(f"state/core binary SHA mismatch state={state['core_sha256']} actual={core_sha}")

    sbytes = supervisor.read_bytes()
    sv = _literal_assignments(sbytes, str(supervisor))
    if sv.get("VERSION") != EXPECTED_R12_VERSION or sv.get("R11_SHA256") != EXPECTED_R11_SHA256 or sv.get("R11_CORE_ID") != EXPECTED_CORE_ID:
        raise RuntimeError("R12.9 literal production contract mismatch")
    embedded_b64 = sv.get("R11_ENGINE_GZIP_B64")
    if not isinstance(embedded_b64, str):
        raise RuntimeError("R12.9 embedded R11 payload missing")
    try:
        embedded_r11 = gzip.decompress(base64.b64decode(embedded_b64.encode("ascii")))
    except Exception as exc:
        raise RuntimeError(f"R12.9 embedded R11 decode failed: {exc}") from exc
    embedded_r11_sha = hashlib.sha256(embedded_r11).hexdigest()
    if embedded_r11_sha != EXPECTED_R11_SHA256 or embedded_r11 != driver.read_bytes():
        raise RuntimeError("external R11 driver is not byte-identical to R12.9 embedded certified R11")

    rv = _literal_assignments(embedded_r11, "<embedded-r11>")
    if rv.get("VERSION") != EXPECTED_R11_VERSION or rv.get("EXPECTED_CORE_ID") != EXPECTED_CORE_ID or rv.get("EMBEDDED_CORE_SOURCE_SHA256") != EXPECTED_CORE_SOURCE_SHA256:
        raise RuntimeError("embedded R11 dense-core contract mismatch")
    core_b64 = rv.get("EMBEDDED_CORE_GZIP_B64")
    if not isinstance(core_b64, str):
        raise RuntimeError("embedded R11 core source payload missing")
    try:
        core_source = gzip.decompress(base64.b64decode(core_b64.encode("ascii")))
    except Exception as exc:
        raise RuntimeError(f"embedded dense-core source decode failed: {exc}") from exc
    core_source_sha = hashlib.sha256(core_source).hexdigest()
    if core_source_sha != EXPECTED_CORE_SOURCE_SHA256:
        raise RuntimeError(f"embedded dense-core source SHA mismatch actual={core_source_sha} expected={EXPECTED_CORE_SOURCE_SHA256}")
    return {
        "status": "GREEN",
        "supervisor": {"path": str(supervisor), "version": EXPECTED_R12_VERSION, "sha256": supervisor_sha},
        "r11_driver": {"path": str(driver), "version": EXPECTED_R11_VERSION, "sha256": driver_sha, "embedded_byte_identical": True},
        "dense_core": {"path": str(core), "id": EXPECTED_CORE_ID, "binary_sha256": core_sha, "source_sha256": core_source_sha, "state_binary_binding": True},
    }

def sql_quote(s: str) -> str:
    return "'" + s.replace("'", "''") + "'"


def load_legacy_stage_blocks(stage_base: Path, target: int, threads: int, memory: str) -> Tuple[np.ndarray, np.ndarray, Dict[str, Any], Dict[str, Dict[str, int]]]:
    import duckdb
    base = stage_base.resolve(strict=True)
    gm = regular_single(base / "manifests" / "canonical_transactions_0_617698.json")
    side = read_sidecar(Path(str(gm) + ".sha256"))
    if side != LEGACY_STAGE_GLOBAL_SHA256 or sha256_file(gm) != LEGACY_STAGE_GLOBAL_SHA256:
        raise RuntimeError("legacy Stage global manifest SHA mismatch")
    obj = read_json(gm)
    if obj.get("schema") != "mybot_stage2_canonical_transactions_v1" or obj.get("release_complete") is not True:
        raise RuntimeError("legacy Stage global contract mismatch")
    if target > int(obj.get("end_height", -1)):
        raise RuntimeError(f"Stage does not cover state target {target}")
    w = regular_single(base / "manifests" / "canonical_transactions_0_617698.windows.tsv")
    expected_wsha = str((obj.get("windows_tsv") or {}).get("sha256") or "").lower()
    if read_sidecar(Path(str(w) + ".sha256")) != expected_wsha or sha256_file(w) != expected_wsha:
        raise RuntimeError("Stage windows.tsv SHA mismatch")
    block_paths: List[Path] = []
    block_sidecars: List[Path] = []
    block_shas: List[str] = []
    nxt = 0
    with w.open("r", encoding="ascii", newline="") as f:
        rows = csv.DictReader(f, delimiter="\t")
        for row in rows:
            h1, h2 = int(row["window_start"]), int(row["window_end"])
            if h1 != nxt or h2 < h1:
                raise RuntimeError(f"Stage window continuity mismatch expected={nxt} got={h1}..{h2}")
            nxt = h2 + 1
            if h1 > target:
                break
            bp = regular_single(base / "windows" / f"window_{h1:06d}_{h2:06d}" / "blocks.parquet")
            recorded = str(row["blocks_sha256"]).lower()
            bside = regular_single(Path(str(bp) + ".sha256"))
            if read_sidecar(bside) != recorded:
                raise RuntimeError(f"Stage blocks sidecar mismatch: {bp}")
            actual = sha256_file(bp)
            if actual != recorded:
                raise RuntimeError(f"Stage blocks payload SHA mismatch: {bp} actual={actual} expected={recorded}")
            block_paths.append(bp); block_sidecars.append(bside); block_shas.append(recorded)
    if not block_paths:
        raise RuntimeError("no Stage blocks payloads selected")
    stage_token_paths = [gm, regular_single(Path(str(gm) + ".sha256")), w, regular_single(Path(str(w) + ".sha256")), *block_paths, *block_sidecars]
    before = {str(p): file_token(p) for p in stage_token_paths}
    con = duckdb.connect(":memory:")
    try:
        con.execute(f"PRAGMA threads={max(1,int(threads))}")
        con.execute(f"PRAGMA memory_limit={sql_quote(memory)}")
        plist = "[" + ",".join(sql_quote(str(p)) for p in block_paths) + "]"
        rows = con.execute(f"""
            SELECT height::BIGINT, block_time::BIGINT
            FROM read_parquet({plist}, union_by_name=true)
            WHERE height BETWEEN 0 AND {int(target)}
            ORDER BY height
        """).fetchall()
        if len(rows) != target + 1:
            raise RuntimeError(f"Stage block coverage rows={len(rows)} expected={target+1}")
        heights = np.fromiter((int(r[0]) for r in rows), dtype=np.int64, count=len(rows))
        if not np.array_equal(heights, np.arange(target + 1, dtype=np.int64)):
            raise RuntimeError("Stage height coverage is not exact 0..target")
        times = np.fromiter((int(r[1]) for r in rows), dtype=np.int64, count=len(rows))
        bh = con.execute(f"SELECT lower(block_hash::VARCHAR) FROM read_parquet({plist}, union_by_name=true) WHERE height=?", [target]).fetchall()
        if len(bh) != 1:
            raise RuntimeError("Stage target block hash missing/duplicated")
        target_hash = str(bh[0][0]).lower()
    finally:
        con.close()
    stage_contract = {
        "global_manifest": str(gm), "global_sha256": LEGACY_STAGE_GLOBAL_SHA256,
        "windows_tsv": str(w), "windows_sha256": expected_wsha,
        "selected_block_files": len(block_paths), "target": target, "target_hash": target_hash,
        "block_payload_set_sha256": canonical_sha([{"path": str(p), "sha256": s} for p, s in zip(block_paths, block_shas)]),
    }
    return times, heights, stage_contract, before


def validate_stage_tokens(tokens: Dict[str, Dict[str, int]]) -> None:
    changed = []
    for p, tok in tokens.items():
        now = file_token(Path(p))
        if not same_token(tok, now):
            changed.append(p)
    if changed:
        raise RuntimeError(f"Stage block payload changed while metrics were running: {changed[:10]}")


def validate_state_audit_evidence(
    explicit: Optional[Path], expected_sha256: Optional[str], state: Dict[str, Any],
    stage: Dict[str, Any], provenance: Dict[str, Any], allow_missing: bool,
) -> Optional[Dict[str, Any]]:
    """Bind metrics to the immutable V51.5.2 heavy Stage->UTXO proof already completed at 617698."""
    if explicit is None:
        if allow_missing:
            LOG.warning("No independent state-audit evidence supplied; diagnostic mode only")
            return None
        raise RuntimeError("--state-audit-report is required for production metrics")
    p = regular_single(explicit)
    actual_sha = sha256_file(p)
    if not expected_sha256:
        if allow_missing:
            LOG.warning("State-audit evidence SHA not pinned; diagnostic mode only")
        else:
            raise RuntimeError("--state-audit-report-sha256 is required for production metrics")
    elif actual_sha != str(expected_sha256).lower():
        raise RuntimeError(f"state-audit report SHA mismatch actual={actual_sha} expected={expected_sha256}")
    obj = read_json(p)
    phases = obj.get("phases") or {}
    ss = phases.get("state_scan") or {}
    sr = phases.get("stage_rebuild") or {}
    sem = phases.get("stage_semantics") or {}
    cse = phases.get("core_stage_exact") or {}
    fg = phases.get("false_green_guard") or {}
    report_stage = obj.get("stage") or {}
    checks = [
        obj.get("schema") == V5152_REPORT_SCHEMA,
        str(obj.get("auditor_sha256") or "").lower() == EXPECTED_V5152_AUDITOR_SHA256,
        int(obj.get("target_height", -1)) == int(state["height"]),
        str(obj.get("failed_phase") or "") == "reference_v40",
        str((phases.get("state_contract") or {}).get("status") or "") == "OK",
        str(ss.get("status") or "") == "OK",
        str(sem.get("status") or "") == "OK",
        str(cse.get("status") or "") == "OK",
        str(sr.get("status") or "") == "OK",
        sr.get("full_stream_hashes") is True,
        str(fg.get("status") or "") == "OK",
        str(report_stage.get("sha256") or "").lower() == str(stage["global_sha256"]).lower(),
        int(ss.get("height", -1)) == int(state["height"]),
        str(ss.get("block_hash") or "").lower() == str(state["block_hash"]).lower(),
        str(ss.get("source_sha256") or "").lower() == str(provenance["stage_source_sha256"]).lower(),
        int(ss.get("tx_count", -1)) == int(state["tx_count"]),
        int(ss.get("out_count", -1)) == int(state["out_count"]),
        int(ss.get("close_count", -1)) == int(state["close_count"]),
        int(ss.get("script_bytes", -1)) == int(state["script_bytes"]),
        int(ss.get("live_count", -1)) == int(state["live_count"]),
        int(ss.get("live_value_sats", -1)) == int(state["live_value_sats"]),
        int(sr.get("expected_close_count", -1)) == int(state["close_count"]),
        int(sr.get("expected_live_count", -1)) == int(state["live_count"]),
        int(sr.get("expected_live_value_sats", -1)) == int(state["live_value_sats"]),
        int(sr.get("unresolved_prevouts", -1)) == 0,
        int(sr.get("double_spends", -1)) == 0,
        str(sr.get("coverage_status") or "") == "OK",
    ]
    if not all(checks):
        raise RuntimeError("independent V51.5.2 state-audit evidence does not match current dense state/Stage")
    return {
        "status": "GREEN_HEAVY_PROOF_REUSED", "path": str(p), "sha256": actual_sha,
        "auditor_sha256": obj.get("auditor_sha256"), "target_height": int(obj.get("target_height")),
        "original_failed_phase": obj.get("failed_phase"),
        "state_live_fingerprint_sha256": ss.get("live_fingerprint_sha256"),
        "stage_expected_live_fingerprint_sha256": sr.get("expected_live_fingerprint_sha256"),
        "tx_stream_sha256": sr.get("tx_stream_sha256"),
        "all_outputs_sha256": sr.get("all_outputs_sha256"),
        "close_stream_sha256": sr.get("close_stream_sha256"),
        "full_stream_hashes": True,
    }


def locate_core_chain_report(audit_dir: Path, target: int, explicit: Optional[Path], expected_report_sha256: Optional[str], state: Dict[str, Any], stage: Dict[str, Any], allow_missing: bool) -> Optional[Dict[str, Any]]:
    candidates: List[Path]
    if explicit:
        candidates = [explicit.resolve(strict=True)]
    else:
        candidates = list(audit_dir.glob(f"audit_v51_5_4_core_chain_{target}_OK_*.json"))
        candidates.sort(key=lambda p: p.name, reverse=True)
    errors: List[str] = []
    for p in candidates:
        try:
            p = regular_single(p)
            report_sha = sha256_file(p)
            if expected_report_sha256 and report_sha != str(expected_report_sha256).lower():
                raise RuntimeError(f"core-chain report SHA mismatch actual={report_sha} expected={expected_report_sha256}")
            obj = read_json(p)
            guard = obj.get("guard") or {}
            st = obj.get("state") or {}
            sg = obj.get("stage") or {}
            checks = {
                "schema": obj.get("schema") == "mybot-v51-core-chain-guard-v1",
                "report_status": obj.get("status") == "OK",
                "auditor_sha256": str(obj.get("auditor_sha256") or "").lower() == EXPECTED_V5154_AUDITOR_SHA256,
                "state_height": int(st.get("height", -1)) == target,
                "state_block_hash": str(st.get("block_hash") or "").lower() == str(state["block_hash"]).lower(),
                "stage_sha256": str(sg.get("sha256") or "").lower() == str(stage["global_sha256"]).lower(),
                "guard_status": guard.get("status") == "OK",
                "heights_checked": int(guard.get("heights_checked", -1)) == target + 1,
                "mismatch_count": int(guard.get("mismatch_count", -1)) == 0,
                "end_anchor_stable": guard.get("end_anchor_stable") is True,
                "stage_payload_stable": guard.get("stage_payload_stable") is True,
                "chain_digest": str(guard.get("expected_chain_digest_sha256") or "") == str(guard.get("observed_chain_digest_sha256") or ""),
                "stage_end_hash": str(guard.get("stage_end_hash") or "").lower() == str(state["block_hash"]).lower(),
            }
            failed_checks = [name for name, ok in checks.items() if not ok]
            if failed_checks:
                raise RuntimeError("core-chain report contract does not match current state/stage: " + ",".join(failed_checks))
            return {
                "path": str(p), "sha256": report_sha, "created_utc": obj.get("created_utc"),
                "auditor_sha256": obj.get("auditor_sha256"),
                "chain_digest_sha256": guard.get("expected_chain_digest_sha256"),
                "heights_checked": int(guard.get("heights_checked")),
            }
        except Exception as exc:
            errors.append(f"{p}: {type(exc).__name__}: {exc}")
    if allow_missing:
        LOG.warning("No valid V51.5.4 core-chain report; continuing only because --allow-no-core-chain-report was set")
        return None
    raise RuntimeError("no valid V51.5.4 core-chain guard evidence for current state: " + " | ".join(errors[:5]))


def infer_ts_unit(s: pd.Series) -> str:
    vals = pd.to_numeric(s, errors="coerce").dropna()
    if vals.empty: return "ms"
    med = float(vals.abs().median())
    if med > 1e17: return "ns"
    if med > 1e14: return "us"
    if med > 1e11: return "ms"
    return "s"


def read_price(path: Path) -> pd.DataFrame:
    path = regular_single(path)
    df = pd.read_csv(path)
    if df.empty:
        raise RuntimeError("price CSV is empty")
    cols = {str(c).strip().lower(): c for c in df.columns}
    tc = cols.get("ts") or cols.get("timestamp") or cols.get("time") or cols.get("date")
    pc = cols.get("c") or cols.get("close") or cols.get("price") or cols.get("value")
    if tc is None or pc is None:
        raise RuntimeError(f"unrecognized price CSV columns: {list(df.columns)}")
    raw = df[tc]
    if pd.api.types.is_numeric_dtype(raw):
        dt = pd.to_datetime(raw, unit=infer_ts_unit(raw), utc=True, errors="coerce")
    else:
        dt = pd.to_datetime(raw, utc=True, errors="coerce")
    px = pd.to_numeric(df[pc], errors="coerce")
    out = pd.DataFrame({"date": dt.dt.date, "price": px}).dropna()
    out = out[out["price"] > 0].groupby("date", as_index=False).agg(price=("price", "last")).sort_values("date")
    if out.empty:
        raise RuntimeError("price CSV has no positive valid rows")
    return out


