def compute_hodl(created_sats: np.ndarray, closure_matrix: np.ndarray, dates: pd.Index) -> Dict[str, pd.Series]:
    n = len(created_sats)
    live = np.zeros(n, dtype=np.int64)
    out = {b.name: np.full(n, np.nan, dtype=np.float64) for b in HODL_BANDS}
    for d in range(n):
        live[d] += int(created_sats[d])
        live -= closure_matrix[d]
        if np.any(live < 0):
            bad = int(np.where(live < 0)[0][0])
            raise RuntimeError(f"HODL cohort became negative day={d} created_day={bad} value={int(live[bad])}")
        total = int(live.sum(dtype=np.int64))
        if total <= 0:
            continue
        for b in HODL_BANDS:
            hi_created = d - b.lo_days
            if hi_created < 0:
                val = 0
            else:
                lo_created = 0 if b.hi_days is None else max(0, d - b.hi_days + 1)
                if lo_created > hi_created:
                    val = 0
                else:
                    val = int(live[lo_created:hi_created+1].sum(dtype=np.int64))
            out[b.name][d] = val / total
    return {k: pd.Series(v, index=dates, dtype="float64") for k, v in out.items()}


def safe_div(a: np.ndarray, b: np.ndarray) -> np.ndarray:
    a = np.asarray(a, dtype=np.float64); b = np.asarray(b, dtype=np.float64)
    out = np.full_like(a, np.nan, dtype=np.float64)
    np.divide(a, b, out=out, where=np.isfinite(b) & (b != 0))
    out[~np.isfinite(out)] = np.nan
    return out


def validate_tx_records(tx: np.memmap, sc: Dict[str, Any], chunk: int = 2_000_000) -> Dict[str, Any]:
    """Linear restatement of the dense-core transaction/frontier contract used by metrics."""
    expected_first_out = 0
    prev_h = -1
    prev_i = -1
    n = int(sc["tx_count"])
    step = max(100_000, int(chunk))
    for s in range(0, n, step):
        e = min(n, s + step)
        r = tx[s:e]
        h = np.asarray(r["height"], dtype=np.int64)
        ti = np.asarray(r["tx_index"], dtype=np.int64)
        vc = np.asarray(r["vout_count"], dtype=np.uint64)
        first = np.asarray(r["first_out"], dtype=np.uint64)
        flags = np.asarray(r["flags"], dtype=np.uint32)
        if np.any(vc == 0):
            raise RuntimeError(f"TxRecord zero vout_count in {s}..{e}")
        if np.any((flags != 0) & (flags != TX_FLAG_COINBASE)):
            raise RuntimeError(f"TxRecord flags invalid in {s}..{e}")
        if len(h) and (int(h.min()) < 0 or int(h.max()) > int(sc["height"])):
            raise RuntimeError(f"TxRecord height out of range in {s}..{e}")
        if np.any(((flags & TX_FLAG_COINBASE) != 0) != (ti == 0)):
            raise RuntimeError(f"TxRecord coinbase/tx_index contract mismatch in {s}..{e}")
        prefix = np.cumsum(vc, dtype=np.uint64)
        expected = np.uint64(expected_first_out) + prefix - vc
        if not np.array_equal(first, expected):
            bad = int(np.flatnonzero(first != expected)[0])
            raise RuntimeError(f"TxRecord first_out frontier mismatch tx_seq={s+bad}")
        if len(h):
            if s == 0:
                if int(h[0]) != 0 or int(ti[0]) != 0 or int(first[0]) != 0:
                    raise RuntimeError("TxRecord genesis frontier mismatch")
            else:
                dh0 = int(h[0]) - prev_h
                if not ((dh0 == 0 and int(ti[0]) == prev_i + 1) or (dh0 == 1 and int(ti[0]) == 0)):
                    raise RuntimeError(f"TxRecord order discontinuity at tx_seq={s}")
            if len(h) > 1:
                dh = h[1:] - h[:-1]
                same_ok = (dh == 0) & (ti[1:] == ti[:-1] + 1)
                next_ok = (dh == 1) & (ti[1:] == 0)
                ok = same_ok | next_ok
                if not np.all(ok):
                    bad = int(np.flatnonzero(~ok)[0]) + 1
                    raise RuntimeError(f"TxRecord order discontinuity at tx_seq={s+bad}")
            prev_h = int(h[-1]); prev_i = int(ti[-1])
            expected_first_out += int(prefix[-1])
        if s == 0 or e == n or (s // step) % 25 == 0:
            LOG.info("tx_records validated=%s/%s", f"{e:,}", f"{n:,}")
    if prev_h != int(sc["height"]):
        raise RuntimeError(f"TxRecord terminal height={prev_h} != checkpoint={sc['height']}")
    if expected_first_out != int(sc["out_count"]):
        raise RuntimeError(f"TxRecord output frontier={expected_first_out} != checkpoint out_count={sc['out_count']}")
    return {"status": "GREEN", "tx_count": n, "out_frontier": expected_first_out, "terminal_height": prev_h}


def build_metrics(args: argparse.Namespace) -> Dict[str, Any]:
    state_path = Path(args.state)
    output_dir = Path(args.output_dir)
    work_dir = Path(args.work_dir)
    work_dir.mkdir(parents=True, exist_ok=True)
    started = time.monotonic()

    with FreezeLease(state_path) as freeze, OutputLease(output_dir):
        sc = parse_state(state_path)
        state_tokens = state_snapshot_tokens(state_path)
        calculator = validate_calculator_contract(sc, Path(args.supervisor), Path(args.driver), Path(args.core))
        provenance = validate_r12_provenance(state_path, sc)
        target = int(sc["height"])
        if args.expected_height is not None and target != int(args.expected_height):
            raise RuntimeError(f"state height={target} != expected-height={args.expected_height}")
        LOG.info("V50 snapshot height=%s tx=%s out=%s close=%s live=%s value=%s", target, sc["tx_count"], sc["out_count"], sc["close_count"], sc["live_count"], sc["live_value_sats"])

        times, heights, stage, stage_tokens = load_legacy_stage_blocks(Path(args.stage_base), target, args.threads, args.memory_limit)
        if stage["target_hash"] != sc["block_hash"]:
            raise RuntimeError(f"Stage/state target hash mismatch {stage['target_hash']} != {sc['block_hash']}")
        if str(stage["global_sha256"]).lower() != str(provenance["stage_source_sha256"]).lower():
            raise RuntimeError(
                f"Stage/APPLY source mismatch stage={stage['global_sha256']} "
                f"apply_terminal={provenance['stage_source_sha256']} current_state={sc['source_sha256']}"
            )
        state_audit = validate_state_audit_evidence(
            Path(args.state_audit_report) if args.state_audit_report else None, args.state_audit_report_sha256,
            sc, stage, provenance, args.allow_no_state_audit_report,
        )
        guard = locate_core_chain_report(Path(args.audit_dir), target, Path(args.core_chain_report) if args.core_chain_report else None, args.core_chain_report_sha256, sc, stage, args.allow_no_core_chain_report)

        price_path = Path(args.price)
        price_df = read_price(price_path)
        price_sha = sha256_file(price_path)

        epoch_days = np.floor_divide(times, 86400).astype(np.int64)
        base_day = int(epoch_days.min()); end_day = int(epoch_days.max())
        height_day = (epoch_days - base_day).astype(np.int32)
        n_days = end_day - base_day + 1
        date_index = pd.Index(pd.to_datetime(np.arange(base_day, end_day + 1), unit="D", utc=True).date.astype(str), name="date")
        day_dates = pd.to_datetime(date_index).date
        pmap = {d: float(p) for d, p in zip(price_df["date"], price_df["price"])}
        first_price = min(pmap)
        last_price = max(pmap)
        if day_dates[-1] > last_price:
            raise RuntimeError(f"price series ends {last_price} before metrics range end {day_dates[-1]}")
        px = np.full(n_days, np.nan, dtype=np.float64)
        last = np.nan
        for i, d in enumerate(day_dates):
            if d in pmap: last = pmap[d]
            if d >= first_price and np.isfinite(last): px[i] = last
        price_valid = np.isfinite(px) & (px > 0)
        cost_px = np.where(price_valid, px, 0.0)
        LOG.info("calendar=%s..%s days=%s first_price=%s", date_index[0], date_index[-1], n_days, first_price)

        tx = np.memmap(state_path / "tx_records.bin", dtype=TX_DTYPE, mode="r", shape=(sc["tx_count"],))
        outs = np.memmap(state_path / "outputs.bin", dtype=OUT_DTYPE, mode="r", shape=(sc["out_count"],))
        closes = np.memmap(state_path / "closes.bin", dtype=CLOSE_DTYPE, mode="r", shape=(sc["close_count"],))
        scripts = np.memmap(state_path / "scripts.bin", dtype=np.uint8, mode="r", shape=(sc["script_bytes"],)) if sc["script_bytes"] else None
        tx_validation = validate_tx_records(tx, sc)

        created_sats = np.zeros(n_days, dtype=np.int64)
        created_count = np.zeros(n_days, dtype=np.int64)
        created_cost = np.zeros(n_days, dtype=np.float64)
        created_coinbase_sats = np.zeros(n_days, dtype=np.int64)
        eligible_output_count = 0
        ineligible_output_count = 0
        expected_script_offset = 0

        out_chunk = max(100_000, int(args.output_chunk))
        for s in range(0, sc["out_count"], out_chunk):
            e = min(sc["out_count"], s + out_chunk)
            o = outs[s:e]
            txseq = np.asarray(o["tx_seq"], dtype=np.uint64)
            if len(txseq) and int(txseq.max()) >= sc["tx_count"]:
                raise RuntimeError(f"output tx_seq OOB in {s}..{e}")
            vals = np.asarray(o["value_sats"], dtype=np.int64)
            if np.any(vals < 0) or np.any(vals > MAX_MONEY_SATS):
                raise RuntimeError(f"output value out of range in {s}..{e}")
            trs = tx[txseq]
            h = np.asarray(trs["height"], dtype=np.int64)
            if len(h) and int(h.max()) > target:
                raise RuntimeError(f"output created height beyond target in {s}..{e}")
            oid = np.arange(s, e, dtype=np.uint64)
            owner_first = np.asarray(trs["first_out"], dtype=np.uint64)
            owner_vouts = np.asarray(trs["vout_count"], dtype=np.uint64)
            if np.any((oid < owner_first) | (oid >= owner_first + owner_vouts)):
                bad = int(np.flatnonzero((oid < owner_first) | (oid >= owner_first + owner_vouts))[0])
                raise RuntimeError(f"OutputRecord owner/frontier mismatch output_id={s+bad}")
            d = height_day[h]
            oflags = np.asarray(o["flags"], dtype=np.uint32)
            if np.any((oflags & ~np.uint32(OUT_FLAG_ELIGIBLE)) != 0):
                raise RuntimeError(f"unknown OutputRecord flags in {s}..{e}")
            lens = np.asarray(o["script_len"], dtype=np.uint32)
            offs = np.asarray(o["script_offset"], dtype=np.uint64)
            if len(lens) and np.any(offs + lens.astype(np.uint64) > np.uint64(sc["script_bytes"])):
                raise RuntimeError(f"output script bounds violation in {s}..{e}")
            if len(lens):
                lens64 = lens.astype(np.uint64)
                script_prefix = np.cumsum(lens64, dtype=np.uint64)
                expected_offs = np.uint64(expected_script_offset) + script_prefix - lens64
                if not np.array_equal(offs, expected_offs):
                    bad = int(np.flatnonzero(offs != expected_offs)[0])
                    raise RuntimeError(f"OutputRecord script frontier mismatch output_id={s+bad}")
                expected_script_offset += int(script_prefix[-1])
            first_is_opreturn = np.zeros(len(o), dtype=bool)
            nz = lens > 0
            if np.any(nz):
                if scripts is None:
                    raise RuntimeError("non-empty output scripts but scripts.bin is empty")
                first_is_opreturn[nz] = np.asarray(scripts[offs[nz].astype(np.intp)], dtype=np.uint8) == np.uint8(0x6A)
            expected_eligible = (h != 0) & (lens <= MAX_SCRIPT_SIZE) & (~first_is_opreturn)
            eligible = (oflags & OUT_FLAG_ELIGIBLE) != 0
            if not np.array_equal(eligible, expected_eligible):
                bad = int(np.flatnonzero(eligible != expected_eligible)[0])
                raise RuntimeError(f"OutputRecord eligibility flag mismatch output_id={s+bad}")
            eligible_output_count += int(np.count_nonzero(eligible))
            ineligible_output_count += int(len(eligible) - np.count_nonzero(eligible))
            if np.any(eligible):
                ed = d[eligible]; ev = vals[eligible]
                add_at_int(created_sats, ed, ev)
                created_count += np.bincount(ed, minlength=n_days).astype(np.int64)
                add_at_float(created_cost, ed, (ev.astype(np.float64) / 1e8) * cost_px[ed])
                cb = (np.asarray(trs["flags"], dtype=np.uint32)[eligible] & TX_FLAG_COINBASE) != 0
                if np.any(cb): add_at_int(created_coinbase_sats, ed[cb], ev[cb])
            if s == 0 or e == sc["out_count"] or (s // out_chunk) % 20 == 0:
                LOG.info("outputs scanned=%s/%s", f"{e:,}", f"{sc['out_count']:,}")
        if expected_script_offset != int(sc["script_bytes"]):
            raise RuntimeError(f"OutputRecord script frontier={expected_script_offset} != checkpoint script_bytes={sc['script_bytes']}")

        closed_sats = np.zeros(n_days, dtype=np.int64)
        closed_count = np.zeros(n_days, dtype=np.int64)
        closed_cost = np.zeros(n_days, dtype=np.float64)
        spent_sats = np.zeros(n_days, dtype=np.int64)
        spend_inputs = np.zeros(n_days, dtype=np.int64)
        matched_inputs = np.zeros(n_days, dtype=np.int64)
        asopr_matched_inputs = np.zeros(n_days, dtype=np.int64)
        sopr_num = np.zeros(n_days, dtype=np.float64)
        sopr_den = np.zeros(n_days, dtype=np.float64)
        asopr_num = np.zeros(n_days, dtype=np.float64)
        asopr_den = np.zeros(n_days, dtype=np.float64)
        cdd = np.zeros(n_days, dtype=np.float64)
        cohort_close = np.zeros((n_days, n_days), dtype=np.int64)
        bip30_overwrite_count = 0
        causality_clamped = 0
        # One byte per output (~1.34 GiB at current target).  This independent set
        # makes duplicate CloseRecords fail closed without relying on checkpoint arithmetic.
        close_seen = np.zeros(sc["out_count"], dtype=np.bool_)

        close_chunk = max(100_000, int(args.close_chunk))
        for s in range(0, sc["close_count"], close_chunk):
            e = min(sc["close_count"], s + close_chunk)
            c = closes[s:e]
            oid = np.asarray(c["output_id"], dtype=np.uint64)
            closer = np.asarray(c["closer_tx_seq"], dtype=np.uint64)
            typ = np.asarray(c["type"], dtype=np.uint32)
            vin = np.asarray(c["vin"], dtype=np.uint32)
            if len(oid) and int(oid.max()) >= sc["out_count"]:
                raise RuntimeError(f"close output_id OOB in {s}..{e}")
            # Detect duplicates within this chunk and against every earlier chunk.
            # Sorting 2M uint64 ids is bounded and avoids a false-negative from fancy-index writes.
            if len(oid) > 1:
                ordered_oid = np.sort(oid.copy())
                if np.any(ordered_oid[1:] == ordered_oid[:-1]):
                    bad = int(ordered_oid[np.flatnonzero(ordered_oid[1:] == ordered_oid[:-1])[0]])
                    raise RuntimeError(f"duplicate CloseRecord output_id={bad} within {s}..{e}")
            if np.any(close_seen[oid.astype(np.intp, copy=False)]):
                bad = int(oid[np.flatnonzero(close_seen[oid.astype(np.intp, copy=False)])[0]])
                raise RuntimeError(f"duplicate CloseRecord output_id={bad} across chunks")
            close_seen[oid.astype(np.intp, copy=False)] = True
            if len(closer) and int(closer.max()) >= sc["tx_count"]:
                raise RuntimeError(f"close closer_tx_seq OOB in {s}..{e}")
            if np.any((typ != CLOSE_SPEND) & (typ != CLOSE_BIP30)):
                raise RuntimeError(f"invalid close type in {s}..{e}")
            if np.any((typ == CLOSE_BIP30) & (vin != NO_VIN)):
                raise RuntimeError(f"BIP30 close vin contract mismatch in {s}..{e}")
            if np.any((typ == CLOSE_SPEND) & (vin == NO_VIN)):
                raise RuntimeError(f"normal spend close uses NO_VIN in {s}..{e}")
            o = outs[oid]
            if np.any((np.asarray(o["flags"], dtype=np.uint32) & OUT_FLAG_ELIGIBLE) == 0):
                raise RuntimeError(f"close references ineligible output in {s}..{e}")
            vals = np.asarray(o["value_sats"], dtype=np.int64)
            created_tx = np.asarray(o["tx_seq"], dtype=np.uint64)
            created_records = tx[created_tx]
            closer_records = tx[closer]
            ch = np.asarray(created_records["height"], dtype=np.int64)
            sh = np.asarray(closer_records["height"], dtype=np.int64)
            cti = np.asarray(created_records["tx_index"], dtype=np.int64)
            sti = np.asarray(closer_records["tx_index"], dtype=np.int64)
            noncausal = (sh < ch) | ((sh == ch) & (sti <= cti))
            if np.any(noncausal):
                raise RuntimeError(f"non-causal close position in {s}..{e}")
            cd = height_day[ch]
            sd_raw = height_day[sh]
            clamp = sd_raw < cd
            causality_clamped += int(np.count_nonzero(clamp))
            sd = np.maximum(sd_raw, cd)
            cts = times[ch]; sts = times[sh]
            age_sec = np.maximum(sts - cts, 0).astype(np.int64)

            add_at_int(closed_sats, sd, vals)
            closed_count += np.bincount(sd, minlength=n_days).astype(np.int64)
            add_at_float(closed_cost, sd, (vals.astype(np.float64) / 1e8) * cost_px[cd])
            np.add.at(cohort_close, (sd.astype(np.intp), cd.astype(np.intp)), vals)

            normal = typ == 1
            bip30_overwrite_count += int(np.count_nonzero(typ == 2))
            if np.any(normal):
                nd = sd[normal]; nv = vals[normal]; ncd = cd[normal]; nage = age_sec[normal]
                add_at_int(spent_sats, nd, nv)
                spend_inputs += np.bincount(nd, minlength=n_days).astype(np.int64)
                valid = price_valid[nd] & price_valid[ncd]
                if np.any(valid):
                    vd = nd[valid]; vv = nv[valid].astype(np.float64) / 1e8
                    vcd = ncd[valid]
                    matched_inputs += np.bincount(vd, minlength=n_days).astype(np.int64)
                    add_at_float(sopr_num, vd, vv * px[vd])
                    add_at_float(sopr_den, vd, vv * px[vcd])
                    aged = valid & (nage >= 3600)
                    if np.any(aged):
                        ad = nd[aged]; av = nv[aged].astype(np.float64) / 1e8; acd = ncd[aged]
                        asopr_matched_inputs += np.bincount(ad, minlength=n_days).astype(np.int64)
                        add_at_float(asopr_num, ad, av * px[ad])
                        add_at_float(asopr_den, ad, av * px[acd])
                add_at_float(cdd, nd, (nv.astype(np.float64) / 1e8) * (nage.astype(np.float64) / 86400.0))
            if s == 0 or e == sc["close_count"] or (s // close_chunk) % 20 == 0:
                LOG.info("closes scanned=%s/%s", f"{e:,}", f"{sc['close_count']:,}")

        if eligible_output_count + ineligible_output_count != sc["out_count"]:
            raise RuntimeError("all output count extraction mismatch")
        if int(created_count.sum()) != eligible_output_count:
            raise RuntimeError("eligible created output count extraction mismatch")
        if int(closed_count.sum()) != sc["close_count"]:
            raise RuntimeError("close count extraction mismatch")
        if int(np.count_nonzero(close_seen)) != sc["close_count"]:
            raise RuntimeError("CloseRecord uniqueness cardinality mismatch")
        if eligible_output_count - sc["close_count"] != sc["live_count"]:
            raise RuntimeError(f"eligible-close-live arithmetic mismatch eligible={eligible_output_count} close={sc['close_count']} live={sc['live_count']}")
        final_live_count = int((created_count - closed_count).sum())
        final_live_value = int((created_sats - closed_sats).sum())
        if final_live_count != sc["live_count"]:
            raise RuntimeError(f"extracted live_count={final_live_count} != checkpoint={sc['live_count']}")
        if final_live_value != sc["live_value_sats"]:
            raise RuntimeError(f"extracted live_value={final_live_value} != checkpoint={sc['live_value_sats']}")

        supply_sats = np.cumsum(created_sats - closed_sats, dtype=np.int64)
        live_count_series = np.cumsum(created_count - closed_count, dtype=np.int64)
        if int(supply_sats[-1]) != sc["live_value_sats"] or int(live_count_series[-1]) != sc["live_count"]:
            raise RuntimeError("terminal daily state does not match checkpoint")
        supply_btc = supply_sats.astype(np.float64) / 1e8
        realized_cap = np.cumsum(created_cost - closed_cost, dtype=np.float64)
        market_cap = supply_btc * px
        realized_price = safe_div(realized_cap, supply_btc)
        mvrv = safe_div(market_cap, realized_cap)
        mc_series = pd.Series(market_cap, index=date_index, dtype="float64")
        expanding_std = mc_series.expanding(min_periods=2).std(ddof=0).to_numpy(dtype=np.float64)
        mvrv_z = safe_div(market_cap - realized_cap, expanding_std)
        sopr = safe_div(sopr_num, sopr_den)
        asopr = safe_div(asopr_num, asopr_den)
        coverage = safe_div(matched_inputs.astype(np.float64), spend_inputs.astype(np.float64))
        asopr_coverage = safe_div(asopr_matched_inputs.astype(np.float64), spend_inputs.astype(np.float64))
        dormancy = safe_div(cdd, spent_sats.astype(np.float64) / 1e8)

        LOG.info("computing HODL waves over %s calendar days", n_days)
        hodl = compute_hodl(created_sats, cohort_close, date_index)
        if not np.isclose(sum(float(h.iloc[-1]) for h in hodl.values()), 1.0, rtol=0, atol=1e-12):
            raise RuntimeError("terminal HODL wave shares do not sum to 1")

        series: Dict[str, pd.Series] = {
            "utxo_supply_btc": pd.Series(supply_btc, index=date_index),
            "utxo_live_utxo_count": pd.Series(live_count_series.astype(np.float64), index=date_index),
            "utxo_created_btc": pd.Series(created_sats.astype(np.float64)/1e8, index=date_index),
            "utxo_closed_btc": pd.Series(closed_sats.astype(np.float64)/1e8, index=date_index),
            "utxo_spent_btc": pd.Series(spent_sats.astype(np.float64)/1e8, index=date_index),
            "utxo_cap_real_usd": pd.Series(realized_cap, index=date_index),
            "utxo_realized_price": pd.Series(realized_price, index=date_index),
            "utxo_cap_mrkt_cur_usd": pd.Series(market_cap, index=date_index),
            "utxo_mvrv": pd.Series(mvrv, index=date_index),
            "utxo_mvrv_zscore": pd.Series(mvrv_z, index=date_index),
            "utxo_sopr": pd.Series(sopr, index=date_index),
            "utxo_asopr": pd.Series(asopr, index=date_index),
            "utxo_cdd": pd.Series(cdd, index=date_index),
            "utxo_dormancy": pd.Series(dormancy, index=date_index),
            "utxo_raw_inputs": pd.Series(spend_inputs.astype(np.float64), index=date_index),
            "utxo_sopr_coverage_cnt": pd.Series(matched_inputs.astype(np.float64), index=date_index),
            "utxo_sopr_coverage_rate": pd.Series(coverage, index=date_index),
            "utxo_asopr_coverage_cnt": pd.Series(asopr_matched_inputs.astype(np.float64), index=date_index),
            "utxo_asopr_coverage_rate": pd.Series(asopr_coverage, index=date_index),
        }
        for name, s in hodl.items(): series[f"utxo_hodl_{name}"] = s

        # Build a complete candidate release off to the side.  The old GREEN manifest
        # remains authoritative until ALL calculations and final snapshot checks pass.
        staging_dir = output_dir / f".staging.{os.getpid()}.{time.time_ns()}"
        staging_dir.mkdir(parents=True, exist_ok=False)
        staged_outputs: Dict[str, Dict[str, Any]] = {}
        try:
            for name, ser in sorted(series.items()):
                staged_path = staging_dir / f"{name}.csv"
                meta = write_csv_durable(staged_path, ser)
                staged_outputs[name] = {
                    "path": str((output_dir / f"{name}.csv").resolve()),
                    "sha256": meta["sha256"], "rows": meta["rows"], "size": meta["size"],
                }
            fsync_dir(staging_dir)

            validate_stage_tokens(stage_tokens)
            validate_state_tokens(state_tokens)
            final_state = parse_state(state_path)
            if final_state["checkpoint_sha256"] != sc["checkpoint_sha256"] or final_state["meta_sha256"] != sc["meta_sha256"]:
                raise RuntimeError("V50 state identity changed during metrics run")

            manifest = {
            "schema": "mybot-utxo-metrics-v4-manifest-v1",
            "status": "GREEN",
            "version": VERSION,
            "api_schema": METRICS_API_SCHEMA,
            "created_utc": utc_now(),
            "elapsed_sec": round(time.monotonic() - started, 3),
            "metrics_code_sha256": sha256_file(Path(__file__).resolve()),
            "state": sc,
            "calculator_contract": calculator,
            "r12_provenance": provenance,
            "dense_state_validation": tx_validation,
            "stage": stage,
            "independent_state_audit_evidence": state_audit,
            "core_chain_guard": guard,
            "price": {"path": str(price_path.resolve()), "sha256": price_sha, "first_date": str(first_price), "last_date": str(last_price)},
            "calendar": {"start": str(date_index[0]), "end": str(date_index[-1]), "days": n_days, "block_timestamp_causality_clamped_closes": causality_clamped},
            "policy": {
                "canonical_input": "V50_DENSE_STATE_PLUS_CANONICAL_STAGE_BLOCK_TIME",
                "supply_definition": "sum(value_sats) of eligible and unclosed V50 outputs; not consensus-issued supply",
                "output_eligibility": "exact dense-core: height!=0, script_len<=10000, first_byte!=OP_RETURN; flag independently revalidated from scripts.bin",
                "aws_raw_used": False,
                "pre_price_created_cost_basis_usd": 0,
                "asopr_min_age_seconds": 3600,
                "cdd_age_basis": "max(spent_block_time-created_block_time,0)/86400",
                "mvrv_zscore_formula": "(market_cap-realized_cap)/expanding_std(market_cap,ddof=0)",
                "bip30_overwrite_semantics": "removes UTXO inventory/cost basis; excluded from SOPR,aSOPR,CDD,dormancy,raw_inputs",
                "calendar_close_causality": "if raw block timestamp UTC day of close precedes created day, close day is clamped to created day for inventory/HODL accounting",
            },
            "counts": {
                "outputs": sc["out_count"], "eligible_outputs_created": eligible_output_count, "ineligible_outputs_created": ineligible_output_count,
                "closes": sc["close_count"], "normal_spends": int(spend_inputs.sum()),
                "bip30_overwrites": bip30_overwrite_count, "terminal_live_count": final_live_count,
                "terminal_live_value_sats": final_live_value,
            },
            "terminal_checks": {
                "checkpoint_live_count_match": final_live_count == sc["live_count"],
                "checkpoint_live_value_match": final_live_value == sc["live_value_sats"],
                "state_stable": True, "stage_block_payloads_stable": True,
            },
            "locks": freeze.summary(),
            "outputs": staged_outputs,
        }
            manifest["manifest_payload_sha256"] = canonical_sha(manifest)

            # Commit protocol: remove any prior GREEN commit marker first, then promote
            # all candidate CSVs on the same filesystem, and write the new manifest LAST.
            # A crash during promotion therefore leaves no GREEN manifest over mixed bytes.
            manifest_path = output_dir / "utxo_metrics_v4_manifest.json"
            if manifest_path.exists():
                manifest_path.unlink()
                fsync_dir(output_dir)
            for name in sorted(series):
                os.replace(staging_dir / f"{name}.csv", output_dir / f"{name}.csv")
            fsync_dir(output_dir)
            atomic_json(manifest_path, manifest)
            LOG.info("GREEN metrics written to %s", output_dir)
            return manifest
        finally:
            shutil.rmtree(staging_dir, ignore_errors=True)


def preflight(args: argparse.Namespace) -> Dict[str, Any]:
    state_path = Path(args.state)
    with FreezeLease(state_path) as freeze:
        sc = parse_state(state_path)
        calculator = validate_calculator_contract(sc, Path(args.supervisor), Path(args.driver), Path(args.core))
        provenance = validate_r12_provenance(state_path, sc)
        target = int(sc["height"])
        if args.expected_height is not None and target != int(args.expected_height):
            raise RuntimeError(f"state height={target} != expected-height={args.expected_height}")
        times, _, stage, stage_tokens = load_legacy_stage_blocks(Path(args.stage_base), target, args.threads, args.memory_limit)
        if stage["target_hash"] != sc["block_hash"]:
            raise RuntimeError("Stage/state target hash mismatch")
        if str(stage["global_sha256"]).lower() != str(provenance["stage_source_sha256"]).lower():
            raise RuntimeError(
                f"Stage/APPLY source mismatch stage={stage['global_sha256']} "
                f"apply_terminal={provenance['stage_source_sha256']} current_state={sc['source_sha256']}"
            )
        state_audit = validate_state_audit_evidence(
            Path(args.state_audit_report) if args.state_audit_report else None, args.state_audit_report_sha256,
            sc, stage, provenance, args.allow_no_state_audit_report,
        )
        guard = locate_core_chain_report(Path(args.audit_dir), target, Path(args.core_chain_report) if args.core_chain_report else None, args.core_chain_report_sha256, sc, stage, args.allow_no_core_chain_report)
        price_path = Path(args.price)
        prices = read_price(price_path)
        epoch_days = np.floor_divide(times, 86400).astype(np.int64)
        n_days = int(epoch_days.max() - epoch_days.min() + 1)
        validate_stage_tokens(stage_tokens)
        result = {
            "status": "READY", "version": VERSION, "api_schema": METRICS_API_SCHEMA,
            "state": sc, "calculator_contract": calculator, "r12_provenance": provenance,
            "stage": stage, "independent_state_audit_evidence": state_audit, "core_chain_guard": guard,
            "price": {"path": str(price_path.resolve()), "sha256": sha256_file(price_path), "first_date": str(prices["date"].min()), "last_date": str(prices["date"].max())},
            "calendar_days": n_days, "cohort_matrix_estimated_mib": round(n_days*n_days*8/(1<<20), 1),
            "locks": freeze.summary(),
        }
        return result


def selftest() -> int:
    assert TX_DTYPE.itemsize == 56 and OUT_DTYPE.itemsize == 32 and CLOSE_DTYPE.itemsize == 24
    dates = pd.Index(["2020-01-01","2020-01-02","2020-01-03"], name="date")
    created = np.array([100, 50, 25], dtype=np.int64)
    closures = np.zeros((3,3), dtype=np.int64)
    closures[1,0] = 40
    closures[2,1] = 10
    h = compute_hodl(created, closures, dates)
    final = 125
    assert abs(float(h["0_1d"].iloc[-1]) - 25/final) < 1e-12
    assert abs(float(h["1d_1w"].iloc[-1]) - 100/final) < 1e-12
    assert abs(sum(float(x.iloc[-1]) for x in h.values()) - 1.0) < 1e-12
    a = np.array([1.0, 2.0]); b = np.array([1.0, 0.0]); r = safe_div(a,b)
    assert r[0] == 1.0 and np.isnan(r[1])

    # R12 source-lineage contract: historical APPLY records retain their source
    # SHA, while the lineage terminal binds the current state source.
    source_a, source_b = "aa" * 32, "bb" * 32
    fingerprint = "cc" * 32
    lineage_record_sha = "dd" * 32
    epoch = {
        "record_no": 1, "action": PROVENANCE_EPOCH_ACTION,
        "source_sha256": source_a,
        "r11_engine_sha256": EXPECTED_R11_SHA256,
        "supervisor_sha256": EXPECTED_R12_SHA256,
    }
    transition = {
        "record_no": 1, "record_sha256": lineage_record_sha,
        "action": "SOURCE_EXTENSION_COMMIT",
        "old_source_sha256": source_a, "new_source_sha256": source_b,
        "old_source_fingerprint_sha256": "01" * 32,
        "new_source_fingerprint_sha256": "02" * 32,
        "pre_fingerprint_sha256": fingerprint,
        "post_fingerprint_sha256": fingerprint,
        "committed_height": 10, "committed_block_hash": "03" * 32,
        "historical_execution_provenance_changed": False,
        "r11_engine_sha256": EXPECTED_R11_SHA256,
        "supervisor_sha256": EXPECTED_R12_SHA256,
        "prefix_equivalence": {
            "status": "GREEN", "windows_checked": 1, "through_height": 10,
            "window_fingerprint_compatible": True,
            "window_fingerprint_schema": WINDOW_FINGERPRINT_SCHEMA,
        },
    }
    recovery_upgrade = {
        "record_no": 2, "action": "SOURCE_UPGRADE_COMMITTED",
        "old_source_sha256": source_a, "new_source_sha256": source_b,
        "committed_height": 10, "lineage_record_sha256": lineage_record_sha,
        "semantic_fingerprint_unchanged": True,
        "r11_engine_sha256": EXPECTED_R11_SHA256,
        "supervisor_sha256": EXPECTED_R12_SHA256,
    }
    apply_old = [{"record_no": 1, "h1": 0, "h2": 10, "source_sha256": source_a}]
    lineage_ok = _validate_source_lineage(
        apply_old, [epoch, recovery_upgrade], [transition], source_b, 10
    )
    assert lineage_ok["terminal_source_sha256"] == source_b
    assert lineage_ok["apply_terminal_source_sha256"] == source_a

    apply_extended = [
        *apply_old,
        {"record_no": 2, "h1": 11, "h2": 20, "source_sha256": source_b},
    ]
    lineage_extended = _validate_source_lineage(
        apply_extended, [epoch, recovery_upgrade], [transition], source_b, 20
    )
    assert lineage_extended["apply_terminal_source_sha256"] == source_b
    no_upgrade = _validate_source_lineage(apply_old, [epoch], [], source_a, 10)
    assert no_upgrade["records"] == 0 and no_upgrade["terminal_source_sha256"] == source_a

    def expect_lineage_failure(apply_rows, recovery_rows, lineage_rows, state_source, state_height):
        try:
            _validate_source_lineage(apply_rows, recovery_rows, lineage_rows, state_source, state_height)
        except RuntimeError:
            return
        raise AssertionError("invalid source lineage was accepted")

    expect_lineage_failure(apply_old, [epoch], [], source_b, 10)
    expect_lineage_failure(
        [{"record_no": 1, "h1": 0, "h2": 10, "source_sha256": source_b}],
        [epoch, recovery_upgrade], [transition], source_b, 10,
    )
    expect_lineage_failure(
        apply_old, [epoch, recovery_upgrade],
        [{**transition, "post_fingerprint_sha256": "ee" * 32}], source_b, 10,
    )
    expect_lineage_failure(apply_old, [epoch], [transition], source_b, 10)

    # Physical state-contract parser smoke with tiny synthetic sparse files.
    with tempfile.TemporaryDirectory() as td:
        st = Path(td) / "state"; st.mkdir()
        (st / "LOCK").write_bytes(b"")
        (st / "scripts.bin").write_bytes(b"")
        txcap, outcap, closecap, hashcap = 2, 3, 1, 1024
        src = bytes.fromhex("11"*32); core = bytes.fromhex("22"*32); drv = bytes.fromhex(EXPECTED_R11_SHA256)
        m0 = META.pack(b"V50META1",3,0x01020304,txcap,outcap,closecap,hashcap,56,32,24,40,src,core,drv,b"\0"*32)
        m = m0[:-32] + hashlib.sha256(m0[:-32]).digest(); (st/"state.meta").write_bytes(m)
        c0 = CHECKPOINT.pack(b"V50CP01\x00",3,1,bytes.fromhex("33"*32),2,3,1,0,2,75,0,0,src,b"\0"*32)
        c = c0[:-32] + hashlib.sha256(c0[:-32]).digest(); (st/"checkpoint.bin").write_bytes(c)
        (st/"tx_records.bin").write_bytes(b"\0"*(txcap*56))
        (st/"outputs.bin").write_bytes(b"\0"*(outcap*32))
        (st/"closes.bin").write_bytes(b"\0"*(closecap*24))
        parsed = parse_state(st)
        assert parsed["height"] == 1 and parsed["live_count"] == 2 and parsed["live_value_sats"] == 75
    print("UTXO_METRICS_V4 SELFTEST GREEN")
    return 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Read-only V50 dense-state UTXO indicators")
    p.add_argument("--state", default=str(DEFAULT_STATE))
    p.add_argument("--supervisor", default="/root/mybot/utxo_pipeline_v50_r12_9.py", help="exact production R12.9 supervisor")
    p.add_argument("--driver", default="/root/mybot/utxo_pipeline_v50.py", help="exact certified R11 driver bytes")
    p.add_argument("--core", default="/opt/mybot_data/etl/utxo_v50/runtime/utxo_v50_dense_core", help="production dense-core binary bound by state.meta")
    p.add_argument("--stage-base", default=str(DEFAULT_STAGE_BASE))
    p.add_argument("--price", default=str(DEFAULT_PRICE))
    p.add_argument("--output-dir", default=str(DEFAULT_OUTPUT))
    p.add_argument("--work-dir", default=str(DEFAULT_WORK))
    p.add_argument("--audit-dir", default=str(DEFAULT_AUDIT_DIR))
    p.add_argument("--state-audit-report", help="exact immutable V51.5.2 heavy-proof FATAL JSON (failed only at historical reference)")
    p.add_argument("--state-audit-report-sha256", help="required exact SHA256 pin for independent state-audit evidence")
    p.add_argument("--allow-no-state-audit-report", action="store_true", help="diagnostic only; production requires heavy Stage->UTXO evidence")
    p.add_argument("--core-chain-report", help="explicit V51.5.4 standalone core-chain guard JSON")
    p.add_argument("--core-chain-report-sha256", help="optional exact SHA256 pin for core-chain evidence")
    p.add_argument("--allow-no-core-chain-report", action="store_true", help="diagnostic only; production default requires guard evidence")
    p.add_argument("--expected-height", type=int)
    p.add_argument("--threads", type=int, default=10)
    p.add_argument("--memory-limit", default="12GiB")
    p.add_argument("--output-chunk", type=int, default=5_000_000)
    p.add_argument("--close-chunk", type=int, default=2_000_000)
    p.add_argument("--preflight", action="store_true", help="validate state/stage/guard/price without scanning outputs/closes")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--identity", action="store_true", help="print stable metrics API identity as JSON")
    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parser().parse_args(argv)
    if args.identity:
        print(json.dumps({
            "status": "GREEN", "version": VERSION, "api_schema": METRICS_API_SCHEMA,
        }, ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    if args.selftest:
        return selftest()
    if args.preflight:
        print(json.dumps(preflight(args), ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    manifest = build_metrics(args)
    print(json.dumps({
        "status": manifest["status"], "version": manifest["version"],
        "height": manifest["state"]["height"], "live_count": manifest["counts"]["terminal_live_count"],
        "live_value_sats": manifest["counts"]["terminal_live_value_sats"],
        "manifest": str((Path(args.output_dir)/"utxo_metrics_v4_manifest.json").resolve()),
        "manifest_payload_sha256": manifest["manifest_payload_sha256"],
    }, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise
    except Exception as exc:
        LOG.exception("UTXO metrics v4 FAILED: %s", exc)
        raise
